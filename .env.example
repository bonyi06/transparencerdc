# Copiez ce fichier en ".env" (non versionné) et adaptez les valeurs.

# Clé secrète Flask (signature des cookies de session). À régénérer en
# production, par ex. : python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-value

# Base de données. Par défaut, SQLite local (rien à configurer).
# En production, on peut basculer vers PostgreSQL :
# DATABASE_URL=postgresql+psycopg2://user:motdepasse@localhost:5432/transparencerdc

# Identifiants du compte administrateur créé automatiquement au premier
# lancement de `python import_data.py` (si aucun compte n'existe déjà).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Passez à 1 lorsque le site est servi en HTTPS (recommandé en production).
SESSION_COOKIE_SECURE=0
